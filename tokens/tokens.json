    "rules": {
      "series": "series-1/2/3 form a colour-vision-deficiency-validated set for charts. Never substitute brand accents for them, and never reorder them per chart.",
      "grades": "Grades always pair a letter with a colour; meaning must never ride on hue alone."
    }
  },
  "typography": {
    "display": {
      "family": "Anton",
      "license": "OFL",
      "usage": "Display and headlines, uppercase, tight tracking",
      "weight": 400
    },
    "body": {
      "family": "Barlow",
      "license": "OFL",
      "usage": "Body and UI",
      "weights": { "regular": 400, "medium": 500, "bold": 700 }
    },
    "label": {
      "family": "Barlow Semi Condensed",
      "license": "OFL",
      "usage": "Labels and eyebrows, uppercase",
      "weight": 600,
      "letterSpacing": { "min": "0.04em", "default": "0.05em", "max": "0.06em" }
    }
